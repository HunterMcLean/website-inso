# Copy this file to scripts/.env and fill in your values.
# scripts/.env is gitignored — it should NEVER be committed.

# Required: Netlify Personal Access Token
# Generate one at: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=

# Optional: site name as it appears in your Netlify URL (xyz.netlify.app).
# Defaults to "whimsical-cupcake-98eda4". If you've renamed your site, change this.
NETLIFY_SITE_NAME=whimsical-cupcake-98eda4

# Optional: paste the site UUID directly to skip the lookup step.
# Find it under Site configuration → General → Site details → API ID.
# NETLIFY_SITE_ID=
